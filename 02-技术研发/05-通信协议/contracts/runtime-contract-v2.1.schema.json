{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/contracts/runtime-contract-v2.1.schema.json",
  "title": "SRP Runtime Contract v2.1",
  "oneOf": [
    {"$ref": "#/$defs/session_manifest"},
    {"$ref": "#/$defs/control_event"},
    {"$ref": "#/$defs/ack"},
    {"$ref": "#/$defs/telemetry_frame"},
    {"$ref": "#/$defs/policy_decision"},
    {"$ref": "#/$defs/render_receipt"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "message_type"],
      "properties": {"schema_version": {"const": "2.1"}},
      "additionalProperties": true
    },
    "session_manifest": {
      "type": "object",
      "required": ["schema_version", "message_type", "research_id", "session_id", "study_stage", "runtime_mode", "cue_mode", "assignment_arm", "allocation_index", "randomization_stratum", "randomization_block", "randomization_list_hash", "weather_sequence", "module_durations", "protocol_config_version", "randomization_version", "strategy_version", "device_config", "unity_build_hash", "python_commit", "td_build_hash", "source_policy", "created_utc"],
      "properties": {
        "schema_version": {"const": "2.1"}, "message_type": {"const": "session_manifest"},
        "research_id": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1},
        "study_stage": {"enum": ["level_c", "stage_1", "stage_3"]},
        "runtime_mode": {"enum": ["dev_mock", "dev_replay", "formal_level_c", "formal_stage_1", "formal_stage_3"]},
        "cue_mode": {"enum": ["scene_native", "abstract_pacer"]}, "assignment_arm": {"type": "string", "minLength": 1},
        "allocation_index": {"type": "integer", "minimum": 0}, "randomization_stratum": {"type": "string", "minLength": 1},
        "randomization_block": {"type": "integer", "minimum": 1}, "randomization_list_hash": {"type": "string", "minLength": 1},
        "weather_sequence": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["storm", "heat", "snow", "fade"]}},
        "module_durations": {"type": "object", "required": ["demo", "closed_loop", "lock_transition"], "properties": {"demo": {"type": "number", "exclusiveMinimum": 0}, "closed_loop": {"type": "number", "exclusiveMinimum": 0}, "lock_transition": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        "protocol_config_version": {"type": "string", "minLength": 1}, "randomization_version": {"type": "string", "minLength": 1},
        "strategy_version": {"type": ["string", "null"]},
        "device_config": {
          "type": "object", "required": ["resp", "ecg"],
          "properties": {
            "resp": {"type": "object", "required": ["source"], "properties": {"source": {"enum": ["plux_respiban", "mock", "none"]}}, "additionalProperties": true},
            "ecg": {"type": "object", "required": ["source"], "properties": {"source": {"enum": ["polar_h10", "mock", "none"]}}, "additionalProperties": true}
          },
          "additionalProperties": true
        },
        "unity_build_hash": {"type": "string", "minLength": 1}, "python_commit": {"type": "string", "minLength": 1},
        "td_build_hash": {"type": ["string", "null"]}, "source_policy": {"enum": ["real", "replay", "mock"]},
        "created_utc": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"runtime_mode": {"pattern": "^formal_"}}, "required": ["runtime_mode"]},
          "then": {
            "properties": {
              "source_policy": {"const": "real"},
              "device_config": {
                "properties": {
                  "resp": {"properties": {"source": {"const": "plux_respiban"}}},
                  "ecg": {"properties": {"source": {"const": "polar_h10"}}}
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "control_event": {
      "type": "object", "required": ["schema_version", "message_type", "session_id", "event_id", "control_seq", "event_type", "issued_monotonic_ns", "effective_monotonic_ns", "clock_domain_id", "payload"],
      "properties": {"schema_version": {"const": "2.1"}, "message_type": {"const": "control_event"}, "session_id": {"type": "string", "minLength": 1}, "event_id": {"type": "string", "minLength": 1}, "control_seq": {"type": "integer", "minimum": 0}, "event_type": {"enum": ["prepare", "start", "pause", "abort", "segment", "module", "end"]}, "issued_monotonic_ns": {"type": "integer", "minimum": 0}, "effective_monotonic_ns": {"type": "integer", "minimum": 0}, "clock_domain_id": {"type": "string", "minLength": 1}, "payload": {"type": "object"}},
      "additionalProperties": true
    },
    "ack": {
      "type": "object", "required": ["schema_version", "message_type", "session_id", "event_id", "received_monotonic_ns", "applied_monotonic_ns", "unity_frame", "result", "error_code"],
      "properties": {"schema_version": {"const": "2.1"}, "message_type": {"const": "ack"}, "session_id": {"type": "string"}, "event_id": {"type": "string"}, "received_monotonic_ns": {"type": "integer", "minimum": 0}, "applied_monotonic_ns": {"type": "integer", "minimum": 0}, "unity_frame": {"type": "integer", "minimum": 0}, "result": {"enum": ["applied", "duplicate_ignored", "rejected", "failed"]}, "error_code": {"type": ["string", "null"]}},
      "additionalProperties": true
    },
    "telemetry_frame": {
      "type": "object", "required": ["schema_version", "message_type", "session_id", "frame_seq", "clock_domain_id", "source_monotonic_ns", "received_monotonic_ns", "sent_monotonic_ns", "clock_offset_ns", "clock_drift_ppm", "sync_uncertainty_ns", "module_id", "module_position", "segment", "target_phase", "target_progress", "actual_phase", "actual_progress", "actual_confidence", "recovery_value", "recovery_locked", "signal_quality", "fallback_state", "fallback_reason", "resp_device_state", "ecg_device_state", "cue_mode", "runtime_mode", "policy_decision_id"],
      "properties": {"schema_version": {"const": "2.1"}, "message_type": {"const": "telemetry_frame"}, "session_id": {"type": "string"}, "frame_seq": {"type": "integer", "minimum": 0}, "clock_domain_id": {"type": "string"}, "source_monotonic_ns": {"type": "integer", "minimum": 0}, "received_monotonic_ns": {"type": "integer", "minimum": 0}, "sent_monotonic_ns": {"type": "integer", "minimum": 0}, "clock_offset_ns": {"type": "number"}, "clock_drift_ppm": {"type": "number"}, "sync_uncertainty_ns": {"type": "number", "minimum": 0}, "module_id": {"type": "string"}, "module_position": {"type": "integer", "minimum": 0}, "segment": {"enum": ["demo", "closed_loop", "lock_transition"]}, "target_phase": {"enum": ["inhale", "hold", "exhale", "recovery", "none"]}, "target_progress": {"type": "number", "minimum": 0, "maximum": 1}, "actual_phase": {"enum": ["inhale", "hold", "exhale", "recovery", "none"]}, "actual_progress": {"type": "number", "minimum": 0, "maximum": 1}, "actual_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "recovery_value": {"type": "number", "minimum": 0, "maximum": 1}, "recovery_locked": {"type": "boolean"}, "signal_quality": {"type": "object"}, "fallback_state": {"enum": ["GOOD", "DEGRADED", "UNUSABLE", "DISCONNECTED"]}, "fallback_reason": {"type": ["string", "null"]}, "resp_device_state": {"enum": ["CONNECTED", "DEGRADED", "UNUSABLE", "DISCONNECTED"]}, "ecg_device_state": {"enum": ["CONNECTED", "DEGRADED", "UNUSABLE", "DISCONNECTED"]}, "cue_mode": {"enum": ["scene_native", "abstract_pacer"]}, "runtime_mode": {"enum": ["dev_mock", "dev_replay", "formal_level_c", "formal_stage_1", "formal_stage_3"]}, "policy_decision_id": {"type": ["string", "null"]}},
      "not": {"required": ["calm_index"]}, "additionalProperties": true
    },
    "policy_decision": {
      "type": "object", "required": ["schema_version", "message_type", "decision_id", "session_id", "stage", "position", "candidate_actions", "selected_action", "behavior_probability", "target_policy_probability", "state_snapshot_hash", "random_draw", "reason_code", "fallback_applied", "fallback_reason", "policy_version", "created_monotonic_ns"],
      "properties": {"schema_version": {"const": "2.1"}, "message_type": {"const": "policy_decision"}, "decision_id": {"type": "string"}, "session_id": {"type": "string"}, "stage": {"enum": ["stage_1", "stage_3"]}, "position": {"type": "integer", "minimum": 0}, "candidate_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["storm", "heat", "snow", "fade"]}}, "selected_action": {"enum": ["storm", "heat", "snow", "fade"]}, "behavior_probability": {"type": "number", "minimum": 0, "maximum": 1}, "target_policy_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "state_snapshot_hash": {"type": "string"}, "random_draw": {"type": "number", "minimum": 0, "maximum": 1}, "reason_code": {"type": "string"}, "fallback_applied": {"type": "boolean"}, "fallback_reason": {"type": ["string", "null"]}, "policy_version": {"type": ["string", "null"]}, "created_monotonic_ns": {"type": "integer", "minimum": 0}},
      "additionalProperties": true
    },
    "render_receipt": {
      "type": "object", "required": ["schema_version", "message_type", "receipt_id", "session_id", "event_id", "frame_seq", "unity_frame", "rendered_monotonic_ns", "module_id", "segment", "result", "error_code"],
      "properties": {"schema_version": {"const": "2.1"}, "message_type": {"const": "render_receipt"}, "receipt_id": {"type": "string"}, "session_id": {"type": "string"}, "event_id": {"type": "string"}, "frame_seq": {"type": "integer", "minimum": 0}, "unity_frame": {"type": "integer", "minimum": 0}, "rendered_monotonic_ns": {"type": "integer", "minimum": 0}, "module_id": {"type": "string"}, "segment": {"enum": ["demo", "closed_loop", "lock_transition"]}, "result": {"enum": ["rendered", "skipped", "failed"]}, "error_code": {"type": ["string", "null"]}},
      "additionalProperties": true
    }
  }
}
