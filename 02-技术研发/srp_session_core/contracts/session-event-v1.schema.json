{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/contracts/session-event-v1.schema.json",
  "title": "SRP Session Event v1.0",
  "type": "object",
  "required": [
    "event_schema_version",
    "session_id",
    "event_id",
    "event_seq",
    "event_type",
    "scheduled_monotonic_ns",
    "observed_monotonic_ns",
    "state_before",
    "state_after",
    "module_position",
    "module_id",
    "segment",
    "reason_code",
    "payload"
  ],
  "properties": {
    "event_schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_seq": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "minLength": 1},
    "scheduled_monotonic_ns": {"type": "integer", "minimum": 0},
    "observed_monotonic_ns": {"type": "integer", "minimum": 0},
    "state_before": {"enum": ["CREATED", "PREPARED", "RUNNING", "PAUSED", "COMPLETED", "ABORTED"]},
    "state_after": {"enum": ["CREATED", "PREPARED", "RUNNING", "PAUSED", "COMPLETED", "ABORTED"]},
    "module_position": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
    "module_id": {"type": ["string", "null"]},
    "segment": {"enum": ["demo", "closed_loop", "lock_transition", null]},
    "reason_code": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
