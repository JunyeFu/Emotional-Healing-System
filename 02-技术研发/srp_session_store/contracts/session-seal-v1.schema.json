{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/contracts/session-seal-v1.schema.json",
  "title": "SRP P-02 Session Seal v1.0",
  "type": "object",
  "required": [
    "acknowledged_unclean_segments",
    "archive_hash",
    "created_monotonic_ns",
    "evidence_scope",
    "files",
    "final_state_hash",
    "l0_count",
    "l0_tail_hash",
    "l1_count",
    "l1_tail_hash",
    "manifest_hash",
    "reason_code",
    "seal_hash",
    "store_config_hash"
  ],
  "properties": {
    "acknowledged_unclean_segments": {"type": "array", "items": {"type": "string"}},
    "archive_hash": {"type": "string"},
    "created_monotonic_ns": {"type": "integer", "minimum": 0},
    "evidence_scope": {
      "enum": ["SESSION_REPLAY", "INTERRUPTION_RECOVERY", "DEVELOPMENT_STORAGE_ONLY"]
    },
    "files": {"type": "array", "items": {"type": "object"}},
    "final_state_hash": {"type": "string"},
    "l0_count": {"type": "integer", "minimum": 0},
    "l0_tail_hash": {"type": "string"},
    "l1_count": {"type": "integer", "minimum": 0},
    "l1_tail_hash": {"type": "string"},
    "manifest_hash": {"type": "string"},
    "reason_code": {"type": "string"},
    "seal_hash": {"type": "string"},
    "store_config_hash": {"type": "string"}
  },
  "additionalProperties": false
}
