{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/srp-ijhci/experiment-manifest.schema.json",
  "title": "SRP IJHCI Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "participant_id",
    "session_id",
    "session_index",
    "study_mode",
    "cue_mode",
    "condition_order_code",
    "williams_sequence_code",
    "module_sequence",
    "protocol_version",
    "builds",
    "devices",
    "transport",
    "quality_thresholds",
    "mock_input"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "study_id": {
      "const": "SRP-IJHCI-SNBG-01"
    },
    "participant_id": {
      "type": "string",
      "pattern": "^P\\d{4}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^P\\d{4}_S[12]$"
    },
    "session_index": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "study_mode": {
      "type": "string",
      "enum": [
        "development",
        "pilot",
        "formal"
      ]
    },
    "cue_mode": {
      "type": "string",
      "enum": [
        "scene_native",
        "abstract_pacer"
      ]
    },
    "condition_order_code": {
      "type": "string",
      "enum": [
        "SN_AP",
        "AP_SN"
      ]
    },
    "williams_sequence_code": {
      "type": "string",
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4"
      ]
    },
    "module_sequence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "storm",
          "heat",
          "snow",
          "fade"
        ]
      }
    },
    "protocol_version": {
      "type": "string"
    },
    "randomization_version": {
      "type": "string"
    },
    "randomization_seed_hash": {
      "type": "string"
    },
    "builds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unity_build_version",
        "unity_git_commit",
        "python_git_commit",
        "td_project_hash"
      ],
      "properties": {
        "unity_build_version": {
          "type": "string"
        },
        "unity_git_commit": {
          "type": "string"
        },
        "python_git_commit": {
          "type": "string"
        },
        "td_project_hash": {
          "type": "string"
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "model",
          "config_version"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "serial_hash": {
            "type": "string"
          },
          "sample_rate_hz": {
            "type": [
              "number",
              "null"
            ]
          },
          "config_version": {
            "type": "string"
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "control",
        "realtime",
        "sync_interval_ms"
      ],
      "properties": {
        "control": {
          "type": "string"
        },
        "realtime": {
          "type": "string"
        },
        "sync_interval_ms": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "quality_thresholds": {
      "type": "object",
      "required": [
        "clock_offset_ms_max",
        "feedback_latency_p95_ms_max",
        "module_valid_seconds_min"
      ],
      "properties": {
        "clock_offset_ms_max": {
          "type": "number"
        },
        "feedback_latency_p95_ms_max": {
          "type": "number"
        },
        "module_valid_seconds_min": {
          "type": "number"
        }
      }
    },
    "mock_input": {
      "type": "boolean"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}