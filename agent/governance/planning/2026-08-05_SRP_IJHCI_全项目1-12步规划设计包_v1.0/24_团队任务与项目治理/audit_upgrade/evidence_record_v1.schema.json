{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/contracts/evidence-record-v1.schema.json",
  "title": "SRP evidence record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_type", "scope", "candidate_identity", "evidence_refs", "review"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["task_review", "human_signoff", "external_capability", "route_closure", "input_impact"]},
    "scope": {"type": "string", "minLength": 1},
    "candidate_identity": {"type": "string", "minLength": 1},
    "source_commit": {"type": ["string", "null"]},
    "input_snapshot_id": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "role", "method"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "FAIL", "EXPIRED"]},
        "reviewer": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "method": {"enum": ["rerun", "witnessed", "record_review", "external_receipt"]},
        "signed_ref": {"type": ["string", "null"]}
      }
    }
  }
}
