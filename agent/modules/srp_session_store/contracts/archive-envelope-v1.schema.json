{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/contracts/archive-envelope-v1.schema.json",
  "title": "SRP P-02 Archive Envelope v1.0",
  "type": "object",
  "required": [
    "archive_schema_version",
    "formal_capable",
    "envelope_hash",
    "manifest",
    "manifest_hash",
    "protocol_config_hash",
    "session_key",
    "store_config_hash"
  ],
  "properties": {
    "archive_schema_version": {"const": "1.0"},
    "formal_capable": {"type": "boolean"},
    "envelope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest": {"type": "object"},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol_config_hash": {"type": "string", "minLength": 1},
    "session_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "store_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
