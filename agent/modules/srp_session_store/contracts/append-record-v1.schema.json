{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/contracts/append-record-v1.schema.json",
  "title": "SRP P-02 Append Record v1.0",
  "type": "object",
  "required": [
    "payload",
    "previous_hash",
    "record_hash",
    "record_id",
    "record_type",
    "recorded_monotonic_ns",
    "segment_index",
    "session_key",
    "storage_schema_version",
    "stream",
    "stream_seq"
  ],
  "properties": {
    "payload": {"type": "object"},
    "previous_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"type": "string", "minLength": 1},
    "recorded_monotonic_ns": {"type": "integer", "minimum": 0},
    "segment_index": {"type": "integer", "minimum": 1},
    "session_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "storage_schema_version": {"const": "1.0"},
    "stream": {"enum": ["l0", "l1"]},
    "stream_seq": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
