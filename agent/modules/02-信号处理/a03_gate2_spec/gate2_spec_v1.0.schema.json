{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srp.local/schemas/a03-gate2-spec-v1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_class", "conditions", "constructs",
    "response_statuses", "ordered_gate", "models", "analysis_sets",
    "formal_parameters", "prohibited_claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "A03_SPEC_CANDIDATE"},
    "conditions": {"const": ["scene_native", "abstract_pacer"]},
    "constructs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panas", "scci", "comprehension", "mental_effort", "stage_error"],
      "properties": {
        "panas": {
          "type": "object", "additionalProperties": false,
          "required": ["dimensions", "combined_total", "role", "version_and_scoring"],
          "properties": {
            "dimensions": {"const": ["positive", "negative"]},
            "combined_total": {"const": false},
            "role": {"const": "GATE3_OUTCOME_AND_STAGE1_CONTEXT"},
            "version_and_scoring": {"const": "PENDING_LEVEL_C_FREEZE"}
          }
        },
        "scci": {
          "type": "object", "additionalProperties": false,
          "required": ["items", "range", "role"],
          "properties": {
            "items": {"const": 4}, "range": {"const": [1, 5]},
            "role": {"const": "MANIPULATION_CHECK_ONLY"}
          }
        },
        "comprehension": {
          "type": "object", "additionalProperties": false,
          "required": ["items", "range", "layers", "items_per_layer", "role"],
          "properties": {
            "items": {"const": 8}, "range": {"const": [0, 8]},
            "layers": {"const": ["target", "actual", "cumulative", "degraded"]},
            "items_per_layer": {"const": 2}, "role": {"const": "FUNCTIONAL_FLOOR"}
          }
        },
        "mental_effort": {
          "type": "object", "additionalProperties": false,
          "required": ["items", "range", "direction", "role"],
          "properties": {
            "items": {"const": 1}, "range": {"const": [1, 9]},
            "direction": {"const": "LOWER_IS_LESS_EFFORT"},
            "role": {"const": "FUNCTIONAL_FLOOR"}
          }
        },
        "stage_error": {
          "type": "object", "additionalProperties": false,
          "required": ["direction", "role"],
          "properties": {
            "direction": {"const": "LOWER_IS_BETTER"},
            "role": {"const": "OBJECTIVE_SAFEGUARD"}
          }
        }
      }
    },
    "response_statuses": {"const": ["RESPONDED", "SKIPPED", "TIMEOUT", "TECH_UNPRESENTED"]},
    "ordered_gate": {"const": [
      "tool_applicability", "scci_direction", "comprehension_total_noninferiority",
      "comprehension_critical_layers_noninferiority", "mental_effort_noninferiority",
      "stage_error_safeguard"
    ]},
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["required_fixed_effects", "scci_item_function", "secondary_family_adjustment"],
      "properties": {
        "required_fixed_effects": {"const": ["cue_mode", "centered_na_pre", "randomization_strata"]},
        "scci_item_function": {"const": "cumulative_logit_candidate"},
        "secondary_family_adjustment": {"const": "BENJAMINI_HOCHBERG_FDR"}
      }
    },
    "analysis_sets": {"const": ["PRIMARY_CONSERVATIVE", "OBSERVED_CASE"]},
    "formal_parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["noninferiority_margins", "critical_layers", "missing_data_rule", "sample_size", "freeze_reason"],
      "properties": {
        "noninferiority_margins": {"type": "null"},
        "critical_layers": {"type": "null"},
        "missing_data_rule": {"type": "null"},
        "sample_size": {"type": "null"},
        "freeze_reason": {"const": "PENDING_LEVEL_B_AND_BLIND_CALIBRATION"}
      }
    },
    "prohibited_claims": {"const": [
      "SCCI_PROVES_FUNCTIONAL_VALUE", "SYNTHETIC_OUTPUT_IS_REAL_CALIBRATION",
      "SYNTHETIC_THRESHOLDS_ARE_FORMAL_MARGINS"
    ]}
  }
}
